{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C++: Run",
      "type": "shell",
      "command": "mkdir -p \"${workspaceFolder}/build/cpp\" && /usr/bin/clang++ -std=c++17 -Wall \"${file}\" -o \"${workspaceFolder}/build/cpp/${fileBasenameNoExtension}\" && \"${workspaceFolder}/build/cpp/${fileBasenameNoExtension}\"",
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": ["$gcc"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Java: Run",
      "type": "shell",
      "command": "mkdir -p \"${workspaceFolder}/build/java\" && javac -d \"${workspaceFolder}/build/java\" \"${file}\" && java -cp \"${workspaceFolder}/build/java\" \"${fileBasenameNoExtension}\"",
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": ["$javac"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
